# Only what has to be known before the bot can start lives here. Everything the
# dashboard configures — bot name and logo, command prefix, ticket categories,
# transcript channel, support role, which server is active, join roles, stats
# channels, logs, booru site keys — is set there and stored in data/, not here.

# Stoat Bot Token - Get this from the Stoat bot settings (required).
BOT_TOKEN=

# Session Token - Get this from the Stoat bot settings (optional, but
# recommended: a few features use REST endpoints the bot token cannot reach).
SESSION_TOKEN=

# Google API Key - Get this from the Google Cloud Console (optional, but required
# for some features like Google Fonts). GOOGLE_FONTS_API_KEY is also accepted and
# takes precedence if both are set.
GOOGLE_API_KEY=

# Dashboard port - the single local control panel that hosts every editor.
# Defaults to 3030, picks next free port if taken (optional).
# DASHBOARD_PORT=3030

# Debug logging - gates the bot's verbose diagnostic output (optional).
# Unset/0/false = off. 1/true/* = everything. Or a comma list of scopes,
# e.g. DEBUG=logs,notify,prime  (scope prefix match, so "notify" also enables
# "notify:poll").
# DEBUG=

# Data directory override - where all JSON stores live. Defaults to ./data.
# Point this at another path to isolate a second instance's data (optional).
# YAOSB_DATA_DIR=

# Music - external programs used for playback (optional).
# Leave YTDLP_PATH unset to let the bot download and auto-update its own yt-dlp in bin/.
# Setting it uses that binary as-is, with no updates.
# YTDLP_PATH=
# FFMPEG_PATH=ffmpeg
# Seconds before leaving a voice channel with nothing playing or nobody listening (default 180).
# MUSIC_IDLE_TIMEOUT_SEC=180
# Maximum queued tracks per server; longer playlists are truncated (default 500).
# MUSIC_MAX_QUEUE=500

# Booru image search - largest file (MB) the bot downloads to re-upload; bigger
# posts are linked instead (default 20).
# BOORU_MAX_UPLOAD_MB=20

# Master key for credentials saved in the dashboard (optional).
# Unset: the bot generates a random key in data/secret.key on first use, so
# data/secrets.json alone is useless to whoever gets hold of it. Set any long
# passphrase here to keep the key out of the data directory entirely. Changing
# or losing it means re-entering the saved keys.
# YAOSB_SECRET_KEY=

# Advanced / rarely needed (optional).
# Launch the notification provider browser with --no-sandbox. Needed when the
# bot runs as root or in a minimal container that cannot grant the sandbox.
# PUPPETEER_NO_SANDBOX=0
# Where the managed yt-dlp binary is stored. Defaults to ./bin.
# YAOSB_BIN_DIR=
# Let notification URL checks resolve private/loopback hosts. Testing only:
# enabling it lets a saved feed URL reach your own network.
# NOTIFY_ALLOW_PRIVATE_HOSTS=0
# Print a stack trace for unhandled promise rejections.
# DEBUG_UNHANDLED_REJECTIONS=0
# Per-editor request body caps, in MB (defaults: embed 2, notify 2, role 1,
# welcome 25). Raise only if an editor rejects a large upload.
# EMBED_EDITOR_MAX_BODY_MB=2
# NOTIFY_EDITOR_MAX_BODY_MB=2
# ROLE_EDITOR_MAX_BODY_MB=1
# WELCOME_EDITOR_MAX_BODY_MB=25
